# dependencies & build output
node_modules/
dist/
dist-e2e-server/
coverage/

# secrets - never commit (see docs/SECURITY_PLAN.md, SEC-02)
.env
.env.*
!.env.example
!.env.e2e-server
supabase/.env
supabase/.temp/

# test artifacts
playwright-report/
test-results/
blob-report/
evals/reports/

# editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log

# raw downloads of the Ministry of Health nutrition database (~8 MB, re-created by npm run build:food-db)
data/raw/

# working files for design reviews (icon ideas, previews)
design/

# Android app: built APKs and signing material (the key and its passwords live in C:\Elad\keys,
# never here). More rules in android/.gitignore.
/release/
*.jks
*.keystore
keystore.properties
*-keystore.properties

# the user's own label photos used to try reading labels (their Lens texts are in tests/fixtures/labels)
labels-test/
